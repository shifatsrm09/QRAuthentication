# Copy this file to `.env` and fill in your own values. Never commit the real file.
# In production (Vercel) set the same variables under
# Project -> Settings -> Environment Variables.

# ---------- Required ----------

# MongoDB connection string (MongoDB Atlas: Database -> Connect -> Drivers).
# On Atlas, allow 0.0.0.0/0 under Network Access so Vercel can connect.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---------- Optional ----------

# Local API port (the React dev server proxies /api to it). Default: 5000
# API_PORT=5000

# Force the public URL that gets encoded in the QR code. Leave unset to
# auto-detect. For phone testing on your network use your computer's LAN
# address, e.g. http://192.168.1.10:3000
# APP_URL=

# Only needed if the frontend is hosted on a different origin than the API.
# FRONTEND_URL=

# Local-only workaround if Atlas lookups fail with "querySrv ECONNREFUSED".
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# Frontend API base path. Defaults to /api (same origin).
# REACT_APP_API_URL=/api
