# Local API (frontend proxy defaults to port 5000)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/qr_authentication
JWT_SECRET=replace-with-a-long-random-secret
# Optional only when local Atlas SRV lookups fail (querySrv ECONNREFUSED):
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional: force the public frontend URL used in QR codes.
# For phone testing use your computer's LAN address, e.g. http://192.168.1.10:3000
# APP_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
